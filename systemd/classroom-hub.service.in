# classroom-hub-template-status=pending-m16-approval
[Unit]
Description=INERT pending M-16 Classroom Hub production display service
Documentation=file:///opt/classroom-hub/docs/migration/m16-review-package.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=exec
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/classroom-hub
Environment=NODE_ENV=production
Environment=CLASSROOM_HUB_PRODUCTION_CONFIG_REFERENCE=/etc/classroom-hub/server/production-server.json
ExecStart=/usr/bin/node /opt/classroom-hub/dist/entrypoints/production-server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/classroom-hub/providers
ReadWritePaths=/var/lib/classroom-hub/production
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Review template only. The .in suffix and absent [Install] section keep this
# exact non-fixture composition non-installable until M-17 is authorized.
