# chalkwright-template-status=m17-offline-qualified-inert
[Unit]
Description=INERT M-17 Chalkwright read-only PowerSchool plan preflight
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/chalkwright-canary/current
EnvironmentFile=/etc/chalkwright/canary/jobs/plan-refresh.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/chalkwright-canary/current/dist/entrypoints/production-plan-refresh.js
TimeoutStartSec=3min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/chalkwright/canary/providers/google-classroom -/etc/chalkwright/canary/providers/google-calendar
ReadWritePaths=/var/lib/chalkwright/canary-production /var/lib/chalkwright/canary-powerschool-session
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=user pid net
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=768M
TasksMax=192

# Separate preflight has no timer and cannot outlive operator invocation.
