# chalkwright-template-status=m17-offline-qualified-inert
[Unit]
Description=INERT M-17 Chalkwright canary SQLite integrity check

[Service]
Type=oneshot
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/chalkwright-canary/current
EnvironmentFile=/etc/chalkwright/canary/jobs/maintenance.env
Environment=NODE_ENV=production
ExecCondition=/usr/bin/node /opt/chalkwright-canary/current/dist/entrypoints/m17-canary-activation-manifest.js --verify-current /etc/chalkwright/canary/activation-manifest.json
ExecStart=/usr/bin/node /opt/chalkwright-canary/current/dist/entrypoints/job.js sqlite-integrity
TimeoutStartSec=2min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/chalkwright/canary/providers -/var/lib/chalkwright/canary-powerschool-session
ReadWritePaths=/var/lib/chalkwright/canary-production
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=256M
TasksMax=64

# The .in suffix and absent [Install] section keep this unit inert.
