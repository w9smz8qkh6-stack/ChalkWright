# chalkwright-template-status=permanent-production-inert
[Unit]
Description=Chalkwright owned Calendar reconciliation timer

[Timer]
OnCalendar=Mon..Fri,Sun *-*-* 07:28:00 Asia/Ho_Chi_Minh
AccuracySec=1s
Persistent=false
Unit=chalkwright-calendar-sync.service

# The .in suffix and absent [Install] section keep this timer inert.
