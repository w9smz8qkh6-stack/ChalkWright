# chalkwright-template-status=permanent-production-inert
# No scheduling or enablement section: this high-authority repair is operator-invoked only.
[Unit]
Description=Chalkwright production PowerSchool authentication repair

[Service]
Type=oneshot
WorkingDirectory=/opt/chalkwright/current
RuntimeDirectory=chalkwright-powerschool-repair-client
RuntimeDirectoryMode=0700
EnvironmentFile=%t/chalkwright-production-repair/plan-refresh.env
EnvironmentFile=%t/chalkwright-production-repair/desktop-repair.env
Environment=NODE_ENV=production
Environment=CLASSROOM_HUB_POWERSCHOOL_IDENTITY_ORIGIN=https://accounts.google.com
Environment=CLASSROOM_HUB_POWERSCHOOL_JIT_HEADLESS=0
Environment=TMPDIR=%t/chalkwright-powerschool-repair-client
UnsetEnvironment=OP_ACCOUNT OP_CONNECT_TOKEN OP_SERVICE_ACCOUNT_TOKEN
ExecStart=/usr/bin/node /opt/chalkwright/current/dist/entrypoints/m17-powerschool-repair.js
TimeoutStartSec=6min
TimeoutStopSec=30s
UMask=0077
# The user manager supplies Bren's real graphical-session environment. Chrome
# still uses only a disposable Chalkwright profile; the root controller
# transfers filtered PowerSchool state after a successful repair and removes
# the high-authority browser profile with the temporary repair runtime.
# Do not add system-manager namespace or no-new-privileges directives here.
# They make Chrome's correctly installed SUID sandbox unusable from a user
# manager. The fixed browser worker retains Chrome's sandbox and its own
# request boundary, while this user one-shot remains resource bounded.
MemoryMax=768M
TasksMax=192
