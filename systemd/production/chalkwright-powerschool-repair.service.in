# chalkwright-template-status=permanent-production-inert
# No scheduling or enablement section: this high-authority repair is operator-invoked only.
[Unit]
Description=Chalkwright production PowerSchool authentication repair
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/chalkwright/current
RuntimeDirectory=chalkwright-powerschool-repair-client
RuntimeDirectoryMode=0700
EnvironmentFile=/etc/chalkwright/production/jobs/plan-refresh.env
EnvironmentFile=/etc/chalkwright/production/jobs/powerschool-repair.env
Environment=NODE_ENV=production
Environment=CLASSROOM_HUB_POWERSCHOOL_IDENTITY_ORIGIN=https://accounts.google.com
Environment=CLASSROOM_HUB_POWERSCHOOL_JIT_HEADLESS=0
Environment=DISPLAY=:0
Environment=TMPDIR=/run/chalkwright-powerschool-repair-client
ExecStart=/usr/bin/node /opt/chalkwright/current/dist/entrypoints/m17-powerschool-repair.js
TimeoutStartSec=6min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
# The repair browser uses only Bren's existing local Xwayland socket. The root
# controller grants the dedicated local-user ACL immediately before this unit
# starts and revokes it after the unit reaches a terminal state. A private /tmp
# namespace would make that socket unreachable; temporary files remain in this
# unit's own mode-0700 runtime directory.
PrivateTmp=false
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/chalkwright/production/providers/google-classroom -/etc/chalkwright/production/providers/google-calendar
ReadWritePaths=/var/lib/chalkwright/production-session /var/lib/chalkwright/production-powerschool-profile
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Chromium's enabled Linux sandbox also requires mount namespaces. Retain a
# deny-list for cgroup, IPC, UTS, and time namespaces instead of blocking its
# required user, PID, network, and mount namespaces.
RestrictNamespaces=~cgroup ipc uts time
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=768M
TasksMax=192
