# chalkwright-template-status=permanent-production-inert
[Unit]
Description=Chalkwright production PowerSchool plan refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/chalkwright/current
EnvironmentFile=/etc/chalkwright/production/jobs/plan-refresh.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/chalkwright/current/dist/entrypoints/production-retained-plan-refresh.js
TimeoutStartSec=3min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/chalkwright/production/providers/google-classroom -/etc/chalkwright/production/providers/google-calendar
ReadWritePaths=/var/lib/chalkwright/production /var/lib/chalkwright/production-session /var/lib/chalkwright/production-powerschool-profile
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=user pid net
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=768M
TasksMax=192

# The .in suffix and absent [Install] section keep this unit inert.
