# chalkwright-template-status=permanent-production-inert
# A private, authenticated X server used only while an operator invokes repair.
# It neither reads provider state nor contains credentials or a browser profile.
[Unit]
Description=Chalkwright isolated headed PowerSchool repair display
StopWhenUnneeded=yes

[Service]
Type=simple
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/chalkwright/current
RuntimeDirectory=chalkwright-powerschool-repair
RuntimeDirectoryMode=0700
Environment=NODE_ENV=production
ExecStart=/opt/chalkwright/current/scripts/operations/run-chalkwright-powerschool-repair-display.sh
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
# The X server and repair browser must share the authenticated local X socket.
PrivateTmp=false
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=128M
TasksMax=32

# The .in suffix and absent [Install] section keep this unit inert.
