# chalkwright-template-status=permanent-production-inert
[Unit]
Description=Chalkwright production SQLite integrity check

[Service]
Type=oneshot
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/chalkwright/current
EnvironmentFile=/etc/chalkwright/production/jobs/maintenance.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/chalkwright/current/dist/entrypoints/job.js sqlite-integrity
TimeoutStartSec=2min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/chalkwright/production/providers -/var/lib/chalkwright/production-powerschool-profile
ReadWritePaths=/var/lib/chalkwright/production
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=256M
TasksMax=64

# The .in suffix and absent [Install] section keep this unit inert.
