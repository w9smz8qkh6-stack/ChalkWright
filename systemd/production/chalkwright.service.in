# chalkwright-template-status=permanent-production-inert
[Unit]
Description=Chalkwright production classroom display
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/chalkwright/current
Environment=NODE_ENV=production
Environment=CLASSROOM_HUB_PRODUCTION_CONFIG_REFERENCE=/etc/chalkwright/production/server.json
ExecStart=/usr/bin/node /opt/chalkwright/current/dist/entrypoints/production-server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/chalkwright/production/providers -/var/lib/chalkwright/production-powerschool-profile
ReadWritePaths=/var/lib/chalkwright/production
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=384M
TasksMax=64

# The .in suffix and absent [Install] section keep this unit inert.
