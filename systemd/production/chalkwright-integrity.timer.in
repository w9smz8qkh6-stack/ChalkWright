# chalkwright-template-status=permanent-production-inert
[Unit]
Description=Chalkwright production SQLite integrity timer

[Timer]
OnCalendar=*-*-* 18:35:00 Asia/Ho_Chi_Minh
AccuracySec=1s
Persistent=false
Unit=chalkwright-integrity.service

# The .in suffix and absent [Install] section keep this timer inert.
