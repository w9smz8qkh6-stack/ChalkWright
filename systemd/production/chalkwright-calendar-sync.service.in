# chalkwright-template-status=permanent-production-inert
[Unit]
Description=Chalkwright owned Calendar reconciliation
After=network-online.target chalkwright-plan-refresh.service
Wants=network-online.target

[Service]
Type=oneshot
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/chalkwright/current
Environment=NODE_ENV=production
Environment=CHALKWRIGHT_PRODUCTION_CALENDAR_CONFIG_REFERENCE=/etc/chalkwright/production/calendar.json
ExecStart=/usr/bin/node /opt/chalkwright/current/dist/entrypoints/production-calendar-sync.js --execute
TimeoutStartSec=3min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/chalkwright/production/providers/powerschool -/etc/chalkwright/production/providers/google-classroom -/var/lib/chalkwright/production-powerschool-profile
ReadWritePaths=/var/lib/chalkwright/production
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=384M
TasksMax=64

# The .in suffix and absent [Install] section keep this unit inert.
