# classroom-hub-template-status=approved-m16-inert
[Unit]
Description=INERT approved M-16 Classroom Hub active-class refresh
Documentation=file:///opt/classroom-hub/docs/migration/m16-review-package.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=classroom-hub
Group=classroom-hub
WorkingDirectory=/opt/classroom-hub
EnvironmentFile=/etc/classroom-hub/jobs/production-classroom-refresh.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/classroom-hub/dist/entrypoints/production-classroom-refresh.js
TimeoutStartSec=1min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/classroom-hub/providers/powerschool -/etc/classroom-hub/providers/google-calendar -/etc/classroom-hub/providers/alert-delivery
ReadWritePaths=/var/lib/classroom-hub/production
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryMax=384M
TasksMax=64

# Accepted policy candidate only. The .in suffix and absent [Install] section
# keep this provider-reading unit non-installable until the M-17 live gate.
