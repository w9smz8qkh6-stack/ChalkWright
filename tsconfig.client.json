{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": false,
    "rootDir": "src/presentation",
    "outDir": "dist/client",
    "declaration": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["src/presentation/display-client.ts"]
}
