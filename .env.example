# Safe, non-secret local defaults only. Never place credentials in this file.
NODE_ENV=development
LOG_LEVEL=info
CLASSROOM_HUB_HOST=127.0.0.1
CLASSROOM_HUB_PORT=4317
# Optional. Set locally to a high-entropy value to enable operator mutations.
CLASSROOM_HUB_OPERATOR_TOKEN=

# M-06 bounded job environment. These are references/policy, never secrets.
# Leave unset until running an explicit local operations job or rehearsal.
CLASSROOM_HUB_INSTANCE_ID=
CLASSROOM_HUB_OPERATIONS_SCOPE_ID=
CLASSROOM_HUB_TIME_ZONE=
CLASSROOM_HUB_MANAGED_ROOT=
CLASSROOM_HUB_DATABASE_PATH=
CLASSROOM_HUB_BACKUP_DIRECTORY=
CLASSROOM_HUB_ACADEMIC_YEAR_END=
CLASSROOM_HUB_JOB_DEADLINE_SECONDS=300
CLASSROOM_HUB_ALERT_DELIVERY_MODE=report-only
# Required only for the synthetic fake-delivery mode; forbidden in report-only.
# CLASSROOM_HUB_ALERT_REPEAT_SECONDS=3600
# Offline-qualified but intentionally unwired M-16 delivery adapter. This is a
# path to an owner-only JSON reference, never a provider value.
CLASSROOM_HUB_ALERT_DELIVERY_REFERENCE=

# M-07C PowerSchool session policy. These are safe placeholders, not
# credentials. Keep the session directory outside the repository at mode 0700.
# Routine collection needs only the PowerSchool/status/bell subset. The manual
# operator-present bootstrap still validates the identity/resource/request
# fields for schema compatibility, but browser-native SSO does not enforce them
# as network controls.
CLASSROOM_HUB_POWERSCHOOL_ROOM_ID=
CLASSROOM_HUB_POWERSCHOOL_ORIGIN=
CLASSROOM_HUB_POWERSCHOOL_STATUS_PATH=
CLASSROOM_HUB_POWERSCHOOL_STATUS_READY_SELECTOR=
CLASSROOM_HUB_POWERSCHOOL_BELL_PATH_TEMPLATE=
CLASSROOM_HUB_POWERSCHOOL_BELL_READY_SELECTOR=
CLASSROOM_HUB_POWERSCHOOL_EXPECTED_SCHOOL_TEXT=
CLASSROOM_HUB_POWERSCHOOL_SESSION_DIRECTORY=
CLASSROOM_HUB_POWERSCHOOL_CHROME_EXECUTABLE=/usr/bin/google-chrome
CLASSROOM_HUB_POWERSCHOOL_NAVIGATION_TIMEOUT_SECONDS=10
CLASSROOM_HUB_POWERSCHOOL_ROUTINE_TIMEOUT_SECONDS=120
CLASSROOM_HUB_POWERSCHOOL_BOOTSTRAP_TIMEOUT_SECONDS=300
CLASSROOM_HUB_POWERSCHOOL_BOOTSTRAP_MAX_REQUESTS=16
CLASSROOM_HUB_POWERSCHOOL_MAX_RESPONSE_BYTES=2097152
CLASSROOM_HUB_POWERSCHOOL_UTC_OFFSET=Z
CLASSROOM_HUB_POWERSCHOOL_IDENTITY_ORIGIN=
CLASSROOM_HUB_POWERSCHOOL_BOOTSTRAP_RESOURCE_ORIGINS=
# ADR-0021 compatibility lane only: dedicated owner-only Google-bearing Chrome
# profile outside the repository and separate from filtered session state.
CLASSROOM_HUB_POWERSCHOOL_COMPATIBILITY_PROFILE_DIRECTORY=
# JIT repair only: owner-only external JSON containing fixed op:// references.
CLASSROOM_HUB_POWERSCHOOL_REPAIR_REFERENCE=
# Optional JIT-only protected legacy environment file. The supervisor parses
# only OP_SERVICE_ACCOUNT_TOKEN as data; it never sources the file as shell.
CLASSROOM_HUB_POWERSCHOOL_ONEPASSWORD_SERVICE_ACCOUNT_ENV=

# M-08 Google Classroom read policy. The credential reference is a path outside
# the repository, never credential material; mappings contain reviewed numeric
# course IDs only. Keep these repository placeholders empty. The qualified job
# wrapper is still not registered with ops:job.
CLASSROOM_HUB_CLASSROOM_CREDENTIAL_REFERENCE=
CLASSROOM_HUB_CLASSROOM_COURSE_MAPPINGS=
CLASSROOM_HUB_CLASSROOM_REQUEST_TIMEOUT_SECONDS=15
CLASSROOM_HUB_CLASSROOM_MAX_PAGES_PER_COURSE=5
CLASSROOM_HUB_CLASSROOM_MAX_ITEMS_PER_COURSE=500
CLASSROOM_HUB_CLASSROOM_MAX_PARALLEL_COURSES=3
CLASSROOM_HUB_CLASSROOM_CACHE_FRESH_SECONDS=900
CLASSROOM_HUB_CLASSROOM_BACKOFF_BASE_SECONDS=60
CLASSROOM_HUB_CLASSROOM_BACKOFF_MAX_SECONDS=3600

# M-13 Calendar ownership audit. The external reference is a separate
# owner-only authorized-user grant with exactly the owned-event read scope.
# These empty placeholders grant no Calendar access or write capability.
CLASSROOM_HUB_CALENDAR_AUDIT_CREDENTIAL_REFERENCE=
CLASSROOM_HUB_CALENDAR_AUDIT_CALENDAR_ID=
CLASSROOM_HUB_CALENDAR_AUDIT_SCOPE_ID=
CLASSROOM_HUB_CALENDAR_AUDIT_REQUEST_TIMEOUT_SECONDS=15
CLASSROOM_HUB_CALENDAR_AUDIT_MAX_PAGES=5
CLASSROOM_HUB_CALENDAR_AUDIT_MAX_EVENTS=500
CLASSROOM_HUB_CALENDAR_AUDIT_MAX_WINDOW_DAYS=14

# One-off M-15 CLI only. Never load this reference into a service or routine job.
CLASSROOM_HUB_M15_CONFIG_REFERENCE=

# M-16/M-17 inert production-reader and isolated job compositions. The owner-only JSON reference
# contains safe runtime policy plus a path to a separate owner-only local
# operator token. It does not contain provider credentials. Do not configure or
# activate these entrypoints until the exact M-16 live gates are approved.
CLASSROOM_HUB_PRODUCTION_CONFIG_REFERENCE=

# M-11 isolated shadow instance. Keep real values in the owner-only external
# EnvironmentFile; these placeholders intentionally grant no capability.
CLASSROOM_HUB_SHADOW_INSTANCE_ID=
CLASSROOM_HUB_SHADOW_ROOM_ID=
CLASSROOM_HUB_SHADOW_SCREEN_ID=
CLASSROOM_HUB_SHADOW_SCREEN_LABEL=
CLASSROOM_HUB_SHADOW_HOST=127.0.0.1
CLASSROOM_HUB_SHADOW_PORT=
CLASSROOM_HUB_SHADOW_PRODUCTION_PORT=
# JSON mappings may include an optional bounded `attendanceClassCode` copied
# from the legacy attendance contract; it is not a PowerSchool section code.
CLASSROOM_HUB_SHADOW_COURSE_MAPPINGS=
CLASSROOM_HUB_SHADOW_CHECKIN_MINUTES=5
CLASSROOM_HUB_SHADOW_DISMISSAL_WARNING_MINUTES=5
